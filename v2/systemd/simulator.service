[Unit]
Description=Smart meter P1 simulator (telegramas DSMR por UART)
After=network.target

[Service]
Type=simple
User=simulator
WorkingDirectory=/opt/smartmeter
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/smartmeter
ExecStart=/usr/bin/python3 /opt/smartmeter/meter_simulator.py --headless
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
